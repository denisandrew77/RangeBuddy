{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: build debug APK",
      "type": "process",
      "command": "${workspaceFolder}/tool/flutterw",
      "args": ["build", "apk", "--debug"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Android: list devices",
      "type": "process",
      "command": "${workspaceFolder}/tool/flutterw",
      "args": ["devices"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
